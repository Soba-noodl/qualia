# Supabase (replace with your project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: analytics
VITE_POSTHOG_KEY=
# Optional: PostHog host override. MUST start with "https://eu." to match the
# EU-hosted claim in the privacy policy. Defaults to https://eu.i.posthog.com.
# A console.warn fires at module load if this is set to a non-EU host.
VITE_POSTHOG_HOST=

# Supabase Edge Function secrets (server-side only; set via Supabase Dashboard →
# Project Settings → Edge Functions → Secrets, NOT in .env.local):
#
#   OPERATOR_EMAIL          — operator inbox for storage-cap alerts. Required by
#                             the storage-cleanup cron; function refuses to start
#                             without it. Replaces the prior hardcoded literal.
#   CONTACT_EMAIL           — operator inbox for contact-form submissions. Required
#                             by send-contact.
#   STORAGE_CRON_SECRET     — bearer token validated by storage-cleanup. Generate
#                             via `openssl rand -hex 32`. Must match the value
#                             pg_cron passes in the Authorization header.
#   RETENTION_CRON_SECRET   — same shape, for send-retention-emails cron.
#
# Supabase DB-level config (consumed by triggers + cron jobs). Stored in
# the `private.cron_config` table (Supabase Cloud doesn't allow ALTER
# DATABASE on the postgres role). The seed migration 20260523189500
# inserts these — fork maintainers should EDIT that migration before
# applying it, or run the equivalent UPSERT manually:
#
#   INSERT INTO private.cron_config (name, value) VALUES
#     ('functions_base_url',        'https://<YOUR_REF>.supabase.co/functions/v1'),
#     ('showcase_publisher_emails', '<operator-email>,<additional-email>'),
#     ('operator_email',            '<operator-email>')
#   ON CONFLICT (name) DO UPDATE SET value = EXCLUDED.value;

# Google Cloud project number (for Drive Picker). Find in Google Cloud Console → IAM & Admin → Settings.
VITE_GOOGLE_APP_ID=<YOUR_GOOGLE_CLOUD_PROJECT_NUMBER>
# Google API key (for Drive Picker). Create in APIs & Services → Credentials → API Keys.
VITE_GOOGLE_API_KEY=

# ─── E2E test account (Playwright suite) ──────────────────────────────────
# Minimum required for the authenticated test project to run:
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
#
# Optional fixtures — each one unlocks a cluster of tests that otherwise
# skip with "requires X fixture on test account". Run `npm run test:e2e:seed`
# after setting these to write them onto the test account. Idempotent.
# See e2e/fixtures/README.md for full details + where to get values.
#
# Required if you set EITHER of the two below:
SUPABASE_SERVICE_ROLE_KEY=          # supabase projects api-keys --project-ref <ref>
INTEGRATION_ENCRYPTION_KEY=         # must match the Edge Function secret
#
# Unlocks audit creation + 3 figma upload-modal tests (~$0.001 per run):
E2E_TEST_BYOK_GEMINI_API_KEY=       # https://aistudio.google.com → Get API Key
#
# Unlocks 3 figma submission tests (single-screen import, prototype crawl, flow analysis):
E2E_TEST_FIGMA_ACCESS_TOKEN=        # Figma → Settings → Security → Personal access tokens

# Lemonsqueezy (server-side only — NEVER prefix with VITE_, must not reach the browser)
# Get from app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=
# Generate locally: `openssl rand -hex 20` → paste into LS webhook config + here
LEMONSQUEEZY_WEBHOOK_SECRET=
# From dashboard URL: app.lemonsqueezy.com/stores/<STORE_ID>/...
LEMONSQUEEZY_STORE_ID=
# Per-product variant IDs (fetch via: GET /v1/variants on LS API)
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_PLUS=
LEMONSQUEEZY_VARIANT_ID_PRO=

# ─── Claude Code skills (.claude/skills/q-analytics) ──────────────────────
# Only needed if you actually run /q-analytics. The skill expands these
# via shell ($VAR) inside curl URLs and BigQuery dataset paths — no
# fallback, fails fast if missing.
POSTHOG_PROJECT_ID=            # PostHog project numeric ID (e.g. 123456)
POSTHOG_PERSONAL_KEY=          # PostHog personal API key (read-only OK)
GCP_GEMINI_PROJECT_ID=         # Google Cloud project hosting Gemini API
GCP_BQ_PROJECT_ID=             # Google Cloud project hosting BigQuery billing export
GCP_BILLING_ACCOUNT_ID=        # Format: XXXXXX-XXXXXX-XXXXXX
