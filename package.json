    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:cursor-rules": "node scripts/sync-claude-to-cursor-rules.js",
