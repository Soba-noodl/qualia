{
  "name": "qualia",
  "private": true,
  "version": "10.0.0",
  "type": "module",
  "description": "AI-powered UX audits. Vite + React + Supabase + Figma plugin. MIT-licensed snapshot of the commercial project archived 2026-05-24.",
  "license": "MIT",
  "homepage": "https://github.com/Soba-noodl/qualia-mvp#readme",
  "repository": {
    "type": "git",
