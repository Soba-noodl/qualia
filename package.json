    "test:e2e:ui": "playwright test --ui",
    "test:e2e:seed": "tsx e2e/fixtures/seed.ts",
    "changelog:md": "python3 scripts/generate-changelog-md.py",
    "lint:rules": "tsx scripts/compliance/lint-rules.ts",
    "compliance": "tsx scripts/compliance/run.ts",
    "ux-audit:prepare": "tsx scripts/ux-audit/prepare.ts",
    "ux-audit:digest": "tsx scripts/ux-audit/digest.ts",
    "ux-audit:rank": "tsx scripts/ux-audit/rank.ts",
    "ux-audit:test": "vitest run --config scripts/ux-audit/vitest.cfg.ts"
  },
